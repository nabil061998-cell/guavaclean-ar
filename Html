<!DOCTYPE html>
<html>
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Guava-Clean AR & Edukasi</title>
    <!-- Import Pustaka A-Frame & AR.js -->
    <script src="https://aframe.io/releases/1.2.0/aframe.min.js"></script>
    <script src="https://raw.githack.com/AR-js-org/AR.js/master/aframe/build/aframe-ar.js"></script>
    <style>
      .ui-container {
        position: fixed;
        bottom: 20px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 999;
        display: flex;
        gap: 10px;
      }
      .btn {
        background-color: #2e7d32;
        color: white;
        border: none;
        padding: 10px 16px;
        border-radius: 20px;
        font-weight: bold;
        font-family: sans-serif;
        cursor: pointer;
        box-shadow: 0 4px 6px rgba(0,0,0,0.3);
      }
    </style>
  </head>
  <body style="margin: 0; overflow: hidden;">

    <!-- Tombol Kontrol Video & AR -->
    <div class="ui-container">
      <button class="btn" onclick="playVideo()">▶ Putar Video Edukasi</button>
    </div>

    <!-- Scene AR.js menggunakan Hiro Marker atau QR Marker -->
    <a-scene embedded arjs="sourceType: webcam; debugUIEnabled: false;">
      
      <!-- Preload Aset -->
      <a-assets>
        <a-asset-item id="flavonoid-model" src="flavonoid.glb"></a-asset-item>
        <a-asset-item id="saponin-model" src="saponin.glb"></a-asset-item>
        <video id="video-edukasi" src="edukasi-20s.mp4" crossorigin="anonymous" loop="false"></video>
      </a-assets>

      <!-- Deteksi Kamera via Marker (Default: Hiro Marker / Marker Pilihan) -->
      <a-marker preset="hiro">
        
        <!-- Model 3D Molekul Flavonoid -->
        <a-entity 
          gltf-model="#flavonoid-model" 
          position="-1 0.5 0" 
          scale="0.5 0.5 0.5" 
          animation="property: rotation; to: 0 360 0; loop: true; dur: 8000">
        </a-entity>

        <!-- Model 3D Molekul Saponin -->
        <a-entity 
          gltf-model="#saponin-model" 
          position="1 0.5 0" 
          scale="0.5 0.5 0.5" 
          animation="property: rotation; to: 0 -360 0; loop: true; dur: 8000">
        </a-entity>

        <!-- Layar Video Edukasi Cuci Tangan 20 Detik -->
        <a-video 
          src="#video-edukasi" 
          width="2" 
          height="1.125" 
          position="0 1.8 -0.5" 
          rotation="-20 0 0">
        </a-video>

      </a-marker>

      <a-entity camera></a-entity>
    </a-scene>

    <script>
      function playVideo() {
        var v = document.getElementById('video-edukasi');
        if (v.paused) {
          v.play();
        } else {
          v.pause();
        }
      }
    </script>
  </body>
</html>
